-- Execute via Command Bar do Roblox Studio, do lado do servidor em Play.
-- Este teste modifica o clã de dois jogadores reais. Use uma sessão de testes, não produção.
local Players = game:GetService("Players")
local Clans = require(game:GetService("ServerScriptService"):WaitForChild("RoMoo"):WaitForChild("Clans"))
local all = Players:GetPlayers()
assert(#all >= 2, "Abra uma sessão com pelo menos 2 clientes.")
local a, b = all[1], all[2]
assert(not Clans.code(a) and not Clans.code(b), "Use jogadores sem clãs para este teste.")
local ok, msg = Clans.create(a)
assert(ok, tostring(msg))
local code = Clans.code(a)
assert(type(code) == "string" and code:match("^%d%d%d%d%d%d$"), "Código inválido.")
local invalid = Clans.join(b, "INVALID")
assert(not invalid, "Código inválido foi aceito.")
local joined = Clans.join(b, code)
assert(joined, "Não foi possível ingressar no clã.")
assert(Clans.allies(a, b), "Aliados não reconhecidos.")
assert(b:GetAttribute("ClanCode") == code, "Tag não replicada.")
assert(b:GetAttribute("ClanMembers") == 2, "Contagem incorreta.")
local left = Clans.leave(a)
assert(left, "Falha ao sair como líder.")
assert(b:GetAttribute("ClanLeader"), "Liderança não foi transferida.")
assert(not Clans.allies(a, b), "Não deveriam continuar aliados.")
assert(Clans.leave(b), "O segundo jogador não saiu.")
assert(not Clans.code(a) and not Clans.code(b), "Dados de clã não foram limpos.")
print("[RoMoo 0.6] PASS: criação, código, entrada, aliança, liderança e saída.")
